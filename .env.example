# Copy this file to ".env" and fill in your own values. Never commit ".env".
# On Render, the same variables are entered in the service's "Environment" tab.

# ---------------------------------------------------------------- API server (server/)
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=accident_detection

# Signs the login tokens: a long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<long-random-string>
JWT_EXPIRE_HOURS=12

# First admin account, created only when the database has no admin yet
ADMIN_USERNAME=<admin-username>
ADMIN_PASSWORD=<admin-password>

# Optional: email on each download from the website (https://resend.com, key with "sending access")
RESEND_API_KEY=<re_...>
RESEND_FROM=AccidentAI <onboarding@resend.dev>
# Without a verified domain in Resend, this must be the email address of your Resend account
NOTIFY_EMAIL=<you@example.com>
# Time zone used in the emails, e.g. Europe/Paris, Africa/Casablanca
NOTIFY_TIMEZONE=UTC

# ---------------------------------------------------------------- Desktop app (run from source)
# API used by the app: a local server (started by the app itself) or the online one.
# The installed .exe ignores this file and always uses the online API (desktop/config.py).
API_URL=http://127.0.0.1:8000
